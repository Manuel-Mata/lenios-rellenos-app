# ─── Base de Datos ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lenios_db?schema=public"

# ─── Configuración del servidor ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development        # "production" en el servidor real

# ─── JWT Authentication ───────────────────────────────────────────────────────
# IMPORTANTE: Usa una clave larga y aleatoria en producción.
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CAMBIA-ESTO-por-una-clave-aleatoria-de-al-menos-64-caracteres"
JWT_EXPIRES_IN="24h"

# ─── Seguridad — Cookies ──────────────────────────────────────────────────────
# Secreto para firmar cookies (diferente al JWT_SECRET)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET="CAMBIA-ESTO-por-otro-secreto-aleatorio-diferente"

# ─── CORS — Orígenes permitidos ───────────────────────────────────────────────
# Lista separada por comas de los orígenes del frontend autorizados.
# En producción usa solo tu dominio HTTPS. Ejemplo: https://tu-dominio.com
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,https://localhost:5173"

# ─── Credenciales del Admin (solo para seed inicial) ─────────────────────────
ADMIN_EMAIL="admin@lenios.com"
ADMIN_PASSWORD="CAMBIA-ESTO-en-produccion"
